# Copy this file to `.env` (no .example) and fill in your project's values.
#
# These are PUBLIC keys. They are safe to ship to the browser because Row-Level
# Security still applies. NEVER put the server's secret key here.
#
# Find them in Supabase: Project Settings -> Data API (URL) and API Keys (publishable).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable or anon key>
