# Copy this file to .env (never commit .env) and fill in the values.
# Supabase dashboard > Project Settings > Data API > Project URL
SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=
# Optional, defaults to 3000
PORT=3000
# Optional: secret used to derive private delivery chat channel names (defaults to SUPABASE_SECRET_KEY)
CHAT_SECRET=
